{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jollyblue",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Persist Workers Logs for every request.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The built hall is served as static assets; only /api/* reaches the
  // Worker. Both hostnames are gated by Cloudflare Access (ADR-0007), so the
  // assets are protected at the edge and the Worker re-verifies the Access
  // JWT on every API call, admitting an email identity only.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // High scores, the only thing JollyBlue remembers (ADR-0006).
  // Migrations: npm run db:migrate:remote (CI applies them before each deploy).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jollyblue",
      "database_id": "b6d22f67-d54f-4424-ad6d-eac983bf7971",
      "migrations_dir": "migrations",
    },
  ],
  // The only public hostnames (ADR-0009). workers.dev and preview URLs are
  // disabled so the hall is reachable solely through the Access-protected
  // custom domains; both are listed on the one Access application.
  "routes": [
    { "pattern": "jollyblue.effectivecode.co.uk", "custom_domain": true },
    { "pattern": "jollyblue.gioscalzo.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Access application "jollyblue" (Zero Trust > Access > Applications).
  // The Worker verifies every Cf-Access-Jwt-Assertion against these; when
  // both are empty (local dev, where there is no Access edge) verification is
  // skipped — see worker/access.ts.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "plain-glitter-718b",
    "ACCESS_AUD": "fe29123b1577247d1048cb5a87526c065e43de9388ba558d874349264aab832f",
  },
}
